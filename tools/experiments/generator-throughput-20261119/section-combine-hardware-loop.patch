+            $s.Add(@{Op='gtu';d=0;s=14;t=7})
+            $s.Add(@{Op='jump-p';u=0;Label=$pair})
+        }
     }
     $s.Add(@{Op='addi';d=15;s=15;i=-1})
     $s.Add(@{Op='gtu';d=0;s=15;t=7})
