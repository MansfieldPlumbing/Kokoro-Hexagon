-        $s.Add(@{Op='addi';d=0;s=0;i=(128*$width)}); $s.Add(@{Op='addi';d=1;s=1;i=(128*$width)})
-        if ($SeparateResidual) { $s.Add(@{Op='addi';d=5;s=5;i=(128*$width)}) }
-        $s.Add(@{Op='addi';d=14;s=14;i=-1})
