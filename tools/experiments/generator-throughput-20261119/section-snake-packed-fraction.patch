         [int][math]::Round([math]::Pow(-1, $k - 1) * [math]::Pow([math]::PI / 2, 2 * $k - 1) / $f * 16384)
@@ -47,7 +47,7 @@ function New-KokoroAdaInSnakeTurnsSteps {
     & $splat 28 (& $half 16384)                 # 1.0 in Q14
     for ($k = 0; $k -lt 5; $k++) { & $splat (23 + $k) (& $half $q14[$k]) }   # v23 = h0 ... v27 = h4
