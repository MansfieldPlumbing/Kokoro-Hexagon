-    $sh = if ($TurnsBits -eq 24) { @{ Fraction = 9; Cos = 11 } } else { @{ Fraction = 11; Cos = 9 } }
+    $sh = if ($TurnsBits -eq 24) { @{ Cos = 11 } } else { @{ Cos = 9 } }
     $q14 = foreach ($k in 1..5) {
