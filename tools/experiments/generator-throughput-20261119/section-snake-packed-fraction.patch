     $s.Add(@{Op='imm';d=12;i=($Channels/32)})
     $s.Add(@{Op='label';Name="${LabelPrefix}_channel"})
     $block=0
@@ -87,9 +87,9 @@ function New-KokoroAdaInSnakeTurnsSteps {
         $s.Add(@{Op='vmpyo-w-h-rnd';d=3;s=14;t=1})
