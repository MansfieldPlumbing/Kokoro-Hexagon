<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Kokoro.Student.PerceptSeed</AssemblyName>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PerceptSeedPath)" LogicalName="Kokoro.Student.PerceptSeed.v1.json" />
  </ItemGroup>
  <Target Name="RequireSeed" BeforeTargets="PrepareForBuild" Condition="'$(PerceptSeedPath)' == ''">
    <Error Text="Provide a sanitized seed using Build-PerceptSeed.ps1." />
  </Target>
</Project>
